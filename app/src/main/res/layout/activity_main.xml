<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_gradient"
    android:gravity="center"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@color/orange_btn_dark"
        android:textSize="44sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="یک شهر بزرگ پر از بازی و ماجرا برای تو!"
        android:textColor="@color/brown_text"
        android:textSize="16sp"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnNewGame"
        android:layout_width="260dp"
        android:layout_height="62dp"
        android:background="@drawable/btn_rounded_orange"
        android:text="@string/btn_start"
        android:textColor="#FFFFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:stateListAnimator="@null" />

    <Button
        android:id="@+id/btnHelp"
        android:layout_width="260dp"
        android:layout_height="50dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/panel_white"
        android:text="@string/btn_help"
        android:textColor="@color/brown_text"
        android:textSize="18sp"
        android:stateListAnimator="@null" />

    <LinearLayout
        android:layout_width="260dp"
        android:layout_height="50dp"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnSound"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:background="@drawable/panel_white"
            android:text="@string/btn_sound_on"
            android:textColor="@color/brown_text"
            android:textSize="14sp"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/btnExit"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:background="@drawable/panel_white"
            android:text="@string/btn_exit"
            android:textColor="@color/brown_text"
            android:textSize="14sp"
            android:stateListAnimator="@null" />
    </LinearLayout>
</LinearLayout>
